# templates/kubeadm-join-worker.yaml.j2
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
nodeRegistration:
  name: {{ ansible_facts['hostname'] }}
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: {{ ansible_facts[interface_name].ipv4.address }}
discovery:
  bootstrapToken:
    token: {{ join_token.stdout }}
    apiServerEndpoint: {{ api_endpoint_host }}:{{ api_endpoint_port }}
    caCertHashes:
      - "sha256:{{ ca_hash.stdout }}"